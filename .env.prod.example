# ─── Domains & TLS ─────────────────────────────────────────────
DOMAIN=grokflow.example.com
API_DOMAIN=api.grokflow.example.com
CADDY_EMAIL=admin@example.com

# Frontend bundle bakes this in at build time. Use the API_DOMAIN
# (or main DOMAIN if you proxy /api through it) accessible from browsers.
PUBLIC_API_URL=https://api.grokflow.example.com

# ─── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=grokflow
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=grokflow

# ─── App secrets (regenerate per environment) ──────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_long_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key

API_KEY_PREFIX=uxpm_live

# ─── App config ────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

STORAGE_DRIVER=local
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_JOBS_PER_PROFILE=1
DEFAULT_DAILY_LIMIT=1000
JOB_TIMEOUT_SECONDS=600

# Allowed origins for the dashboard. Match DOMAIN.
CORS_ORIGINS=https://grokflow.example.com

# ─── Flow video-processing module ─────────────────────────────
# Runs natively inside the backend (FFmpeg in Dockerfile.prod, Postgres
# `flow_jobs` table). No separate container or env vars required — leaving
# this section as documentation only. See docs/FLOW-SETUP.md.

# ─── Image tag (set by CI on deploy) ───────────────────────────
TAG=latest
