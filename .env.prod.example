# ─── Domains & TLS ─────────────────────────────────────────────
DOMAIN=grokflow.example.com
API_DOMAIN=api.grokflow.example.com
CADDY_EMAIL=admin@example.com

# Frontend bundle bakes this in at build time. Use the API_DOMAIN
# (or main DOMAIN if you proxy /api through it) accessible from browsers.
PUBLIC_API_URL=https://api.grokflow.example.com

# ─── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=grokflow
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=grokflow

# ─── App secrets (regenerate per environment) ──────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_long_random_hex_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_fernet_key

API_KEY_PREFIX=uxpm_live

# ─── App config ────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

STORAGE_DRIVER=local
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_JOBS_PER_PROFILE=1
DEFAULT_DAILY_LIMIT=1000
JOB_TIMEOUT_SECONDS=600

# Allowed origins for the dashboard. Match DOMAIN.
CORS_ORIGINS=https://grokflow.example.com

# ─── Flow video-processing module ─────────────────────────────
# Runs natively inside the backend (FFmpeg in Dockerfile.prod, Postgres
# `flow_jobs` table). No separate container or env vars required — leaving
# this section as documentation only. See docs/FLOW-SETUP.md.

# ─── Image tag (set by CI on deploy) ───────────────────────────
TAG=latest

# ─── Auto-deploy notifications (optional) ──────────────────────
# Discord-compatible webhook. Receives a message on every deploy event
# (started, succeeded, failed, rolled back). Leave blank to disable.
# Create one: Discord channel → Edit Channel → Integrations → Webhooks.
DEPLOY_WEBHOOK_URL=

# Seconds to wait for backend /health after a deploy before declaring
# the deploy failed and rolling back. Default 90s.
HEALTH_TIMEOUT_SEC=90

# Set to "false" to disable auto-rollback (e.g. for debugging a bad commit
# on staging — leave the broken commit live so you can SSH in and inspect).
ROLLBACK_ON_FAIL=true

# ─── Host ports (override for staging on same host) ────────────
# Defaults match prod. For staging on the same VPS, bump both so the
# containers don't collide with prod's listener.
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# ─── VNC isolation (override for staging) ─────────────────────
# Defaults match prod. Staging on the same host overrides all three so
# the two stacks spawn VNC containers on different docker networks and
# write distinct nginx map files (different nginx variable names so
# both vhosts coexist in the same HTTP context without clashing).
# Example for staging .env:
#   VNC_NETWORK=grokflow-staging_default
#   VNC_MAP_FILE=_vnc_map_staging.conf
#   VNC_MAP_VAR=vnc_upstream_staging
VNC_NETWORK=grokflow_default
VNC_MAP_FILE=_vnc_map.conf
VNC_MAP_VAR=vnc_upstream
