# ─── GrokFlow — Self-Host config ──────────────────────────────────────────
# This file is auto-generated by install.bat / install.sh on first run.
# You normally don't need to edit anything below — secrets are randomized
# per install. Edit only if you need to change the port or seed admin.

# ─── HTTP port ────────────────────────────────────────────────────────────
# Web UI will be reachable at http://localhost:${HTTP_PORT}
# Change if port 80 is taken (e.g. by IIS / another web server).
HTTP_PORT=80

# ─── Initial admin (used only on first boot) ──────────────────────────────
# Leave INITIAL_ADMIN_PASSWORD blank to auto-generate a strong one — it
# will be printed to the console during install. SAVE IT IMMEDIATELY.
INITIAL_ADMIN_EMAIL=admin@local
INITIAL_ADMIN_PASSWORD=
INITIAL_DOMAIN_LABEL=Local Install

# ─── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_USER=grokflow
POSTGRES_PASSWORD=__REPLACE_ON_INSTALL__
POSTGRES_DB=grokflow

# ─── App secrets (auto-generated on first install) ────────────────────────
# JWT_SECRET: signs auth tokens. Rotating it logs everyone out.
JWT_SECRET=__REPLACE_ON_INSTALL__
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ENCRYPTION_KEY: encrypts stored API keys (Fernet). Rotating it makes
# previously saved provider keys unreadable, so keep this stable.
ENCRYPTION_KEY=__REPLACE_ON_INSTALL__

API_KEY_PREFIX=gfl_live

# ─── App config ───────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false

STORAGE_DRIVER=local
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_JOBS_PER_PROFILE=1
DEFAULT_DAILY_LIMIT=1000
JOB_TIMEOUT_SECONDS=600

# Frontend served from the same origin, so empty CORS is fine.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# ─── Image tag (don't change) ─────────────────────────────────────────────
TAG=latest
