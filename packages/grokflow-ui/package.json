{
  "name": "@grokflow/ui",
  "version": "0.1.0",
  "description": "Shared UI components for GrokFlow plugin modules (Button, Modal, Toast, etc.) — matches the core theme so modules look native when iframed in.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind-preset": "./dist/tailwind-preset.js"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.2"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && cp src/theme.css dist/theme.css && cp src/tailwind-preset.js dist/tailwind-preset.js",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenlehai-dev/grokflow-ui"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
